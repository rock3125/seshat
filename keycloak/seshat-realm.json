{
  "realm": "seshat",
  "displayName": "Seshat",
  "enabled": true,
  "loginTheme": "seshat",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "bruteForceProtected": true,

  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,

  "roles": {
    "realm": [
      {
        "name": "default-roles-seshat",
        "description": "Granted to every user in this realm. Carries use-ui, so a new account can sign in with no extra assignment.",
        "composite": true,
        "composites": { "realm": ["use-ui"] },
        "clientRole": false
      },
      { "name": "use-ui", "description": "May sign in to and use the Seshat chat UI" },
      {
        "name": "admin-observability",
        "description": "May read the audit trail, the consolidated container logs and the metrics panels in the Admin tab."
      },
      {
        "name": "admin",
        "description": "Administrator: may add documents to the library and re-index the corpus. Composite — carries use-ui and admin-observability, so one grant is the whole administrator.",
        "composite": true,
        "composites": { "realm": ["use-ui", "admin-observability"] },
        "clientRole": false
      }
    ]
  },

  "defaultRole": {
    "name": "default-roles-seshat",
    "description": "Default role for realm seshat",
    "composite": true,
    "clientRole": false
  },

  "groups": [
    { "name": "readers", "path": "/readers", "realmRoles": ["use-ui"] },
    { "name": "admins", "path": "/admins", "realmRoles": ["use-ui", "admin"] },
    {
      "name": "auditors",
      "path": "/auditors",
      "realmRoles": ["use-ui", "admin-observability"]
    }
  ],

  "users": [
    {
      "username": "rock",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Rock",
      "lastName": "de Vocht",
      "email": "peter@peter.co.nz",
      "credentials": [
        { "type": "password", "value": "${SEED_ADMIN_PASSWORD:change-me}", "temporary": false }
      ],
      "groups": ["/admins"]
    },
    {
      "username": "guest",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Guest",
      "lastName": "User",
      "email": "info@seshat.com",
      "credentials": [
        { "type": "password", "value": "${SEED_GUEST_PASSWORD:change-me-too}", "temporary": false }
      ],
      "groups": ["/readers"]
    }
  ],

  "clients": [
    {
      "clientId": "seshat-ui",
      "name": "Seshat chat UI",
      "description": "Public browser client, Authorization Code + PKCE. See keycloak/README.md.",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${PUBLIC_URL:http://localhost:8800}/seshat/*",
        "http://localhost:8800/seshat/*",
        "http://127.0.0.1:8800/seshat/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PUBLIC_URL:http://localhost:8800}/seshat/*##http://localhost:8800/seshat/*##http://127.0.0.1:8800/seshat/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "seshat-ui",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
