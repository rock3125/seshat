# Seshat — configuration. Copy to .env and set GEMINI_API_KEY.
#
# Commented-out entries show their default: uncommenting one without changing
# the value changes nothing. .env is gitignored — it holds a real API key and a
# real set of passwords.

# ── The model (fixed for this deployment) ────────────────────────────────────
# One key, one model, no runtime switch. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

#GEMINI_MODEL=gemini-flash-latest        # rolling alias for the current Flash tier
#EMBED_MODEL=gemini-embedding-001
#EMBED_DIMS=768                          # 768 | 1536 | 3072 — INDEX-BREAKING.
                                         # Changing it means the stored vectors
                                         # no longer match the query vectors:
                                         # delete the Qdrant volume and re-index.
                                         # The gateway now refuses to start
                                         # against a collection of another width
                                         # rather than failing on every upsert.
#EMBED_CONCURRENCY=4                      # embedding batches in flight at once
                                         # while indexing. Higher is faster on a
                                         # paid key; on a free one it earns 429s
                                         # and the backoff makes it slower.

# ── The library ──────────────────────────────────────────────────────────────
#LIBRARY_DIR=./library                   # host folder to index (text files only)
#LIBRARY_MIRROR=on                       # the folder is the source of truth —
                                         # deleting a file deletes its document
#LIBRARY_SCAN_MINUTES=1                  # how often the folder is diffed against
                                         # the index: files added by hand are
                                         # indexed, files deleted are dropped
                                         # from Postgres and Qdrant. An upload
                                         # through the UI does not wait for this.
#LIBRARY_UID=1000                        # the gateway runs as this uid:gid, so
#LIBRARY_GID=1000                        # uploaded files are owned by YOU on
                                         # the host and not by root. `id -u`.

# ── Uploads ──────────────────────────────────────────────────────────────────
# Any format may be uploaded: Apache Tika converts anything that is not already
# text (PDF, Word, Excel, PowerPoint, OpenDocument, RTF, EPUB, HTML, email, …)
# into a .txt beside the name it arrived under. Scanned pages need OCR, which
# this build does not ship — they convert to nothing and say so.
#UPLOAD_MAX_MB=25                        # per file. Raise ui/nginx.conf's
                                         # client_max_body_size to match.
#UPLOAD_ADMIN_ONLY=on                    # the library is one shared corpus, so
                                         # adding to it is an admin act. Off
                                         # lets every signed-in account upload.
#EXTRACT_MAX_CHARS=2000000               # ceiling on one converted document.
                                         # Past it the head is indexed and the
                                         # upload reports it was cut.

# ── Chunking ─────────────────────────────────────────────────────────────────
# Sentences are embedded and bunched while they stay on the same subject —
# cosine similarity against the running centroid of the bunch. CHANGING ANY OF
# THESE RE-CHUNKS THE WHOLE CORPUS on the next scan (and re-embeds it, which
# costs API calls): each document records the chunker it was built with, and a
# document whose record no longer matches counts as changed.
#CHUNK_MIN_CHARS=200                     # below this a bunch takes the next
                                         # sentence whatever the similarity is
#CHUNK_MAX_CHARS=3000                    # above this it refuses, however
                                         # similar — a uniform document must
                                         # still be cut somewhere
#SEMANTIC_THRESHOLD=0.75                 # cosine to stay in the same bunch.
                                         # Higher cuts more often.
#SEMANTIC_CHUNKING=on                    # off falls back to paragraph splitting
                                         # and one embedding call per chunk

# ── Where the stack is published ─────────────────────────────────────────────
#SESHAT_PORT=8800                        # the one published port
#BIND_ADDR=127.0.0.1                     # loopback: the stack is meant to sit
                                         # behind a reverse proxy. 0.0.0.0
                                         # publishes it directly — fine on a
                                         # laptop, but on a server it bypasses
                                         # whatever nginx does in front.
#PUBLIC_URL=http://localhost:8800        # as the BROWSER reaches it. Behind an
                                         # outer proxy this is that proxy's
                                         # origin, e.g. https://myserver — it
                                         # goes into the Keycloak token issuer,
                                         # so it must match exactly.
#CORS_ORIGIN=                            # empty, and no CORS headers are sent.
                                         # The app is same-origin in both modes
                                         # (nginx proxies /seshat/api, and the
                                         # Vite dev server proxies the same
                                         # path), so nothing in a browser needs
                                         # them. Set an origin only if you front
                                         # the gateway some other way.

# ── Postgres ─────────────────────────────────────────────────────────────────
#POSTGRES_USER=seshat
#POSTGRES_PASSWORD=seshat                # change before exposing anything
#POSTGRES_DB=seshat
#QDRANT_COLLECTION=seshat

# ── Keycloak ─────────────────────────────────────────────────────────────────
# The console is at ${PUBLIC_URL}/seshat/auth/admin/ — these are its credentials,
# not an application user's. The two application users are defined in
# keycloak/seshat-realm.json.
#KEYCLOAK_ADMIN=admin
#KEYCLOAK_ADMIN_PASSWORD=admin           # change before exposing anything

# ── The audit trail ──────────────────────────────────────────────────────────
# Every user action is recorded: who, when, from where, how long it took, and
# what it touched. Administrators read it in the Admin tab. Kept in Postgres,
# beside the chunks.
#AUDIT_ENABLED=on
#AUDIT_RETENTION_DAYS=90                 # a daily sweep deletes anything older
#AUDIT_CHAT_PROMPTS=off                  # OFF, and this default is a decision.
                                         # The TURN is always recorded — who,
                                         # when, how long, and every search it
                                         # ran. The PROMPT is kept as a sha-256
                                         # prefix and a length, because /chat
                                         # promises no transcript is written
                                         # server-side. ON records the questions
                                         # verbatim, which changes what the
                                         # system promises its users. Tell them.
#AUDIT_READS=off                         # GET /config is polled once a minute
                                         # per open tab; on, that is a row per
                                         # user per minute for ever.
#AUDIT_BLOCKING=off                      # off: a full queue drops records and
                                         # counts them in the metrics. on: it
                                         # back-pressures instead — slower under
                                         # load, and no gaps.

# ── Logs and metrics ─────────────────────────────────────────────────────────
# Alloy tails every container into Loki; Prometheus scrapes the gateway, Qdrant,
# Keycloak and cAdvisor. The Admin tab reads both through the gateway, which
# checks the Keycloak role first — nothing here is published.
#LOG_FORMAT=json                         # every container emits JSON so the
                                         # pipeline ships fields, not a regex's
                                         # guess. `text` restores readable lines
                                         # for a bare `java -jar`. Anything else
                                         # makes the gateway refuse to start.
#LOG_LEVEL=INFO
#LOG_RETENTION_DAYS=14                   # Loki
#METRICS_RETENTION_DAYS=15               # Prometheus
#METRICS_ENABLED=on                      # the gateway's own /metrics endpoint
#LOKI_URL=http://loki:3100               # blank disables the log panel and the
#PROMETHEUS_URL=http://prometheus:9090   # metrics panel — the UI then hides
                                         # them rather than showing a tab that
                                         # only ever 503s
#QDRANT_LOG_LEVEL=INFO

# ── The two seeded accounts ──────────────────────────────────────────────────
# Substituted into keycloak/seshat-realm.json when the realm is first imported.
# They are only read on that first import — after the realm exists, change a
# password in the Keycloak console, not here.
#
# CHANGE BOTH. `rock` is an administrator: it may add documents to the shared
# library, re-index the corpus, and read every other user's audit trail.
# QUOTE a password containing a $ — docker compose interpolates this file, so a
# bare $Secret is read as a reference to an undefined variable and arrives
# empty. 'single quotes' (or $$) keep the dollar literal.
SEED_ADMIN_PASSWORD='change-me'
SEED_GUEST_PASSWORD='change-me-too'
